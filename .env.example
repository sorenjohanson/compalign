# Authentication Configuration
# Authentication mode: 'local', 'supabase', or 'disabled'
PUBLIC_AUTH_MODE=local

# Collaboration Configuration
# Collaboration mode: 'local', 'supabase', or 'disabled'
PUBLIC_COLLABORATION_MODE=local

# Supabase Configuration (for hosted auth and collaboration)
PUBLIC_SUPABASE_URL=your_supabase_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# Stripe Configuration
# Get these values from your Stripe dashboard
PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link
PUBLIC_STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here