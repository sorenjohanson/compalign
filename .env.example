# Authentication Configuration
# Authentication mode: 'local', 'supabase', or 'disabled'
VITE_AUTH_MODE=local

# Collaboration Configuration
# Collaboration mode: 'local', 'supabase', or 'disabled'
VITE_COLLABORATION_MODE=local

# Supabase Configuration (for hosted auth and collaboration)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Legacy Feature Flags (for backwards compatibility)
# These are now automatically handled by the provider system
ENABLE_COLLABORATION=true
ENABLE_COLLABORATION_API=true
ENABLE_SOCKET_IO=true

# Stripe Configuration
# Get these values from your Stripe dashboard
# Use test values for development, live values for production

STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret