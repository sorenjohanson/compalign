# Feature Flags
# Enable real-time collaboration features (disabled by default in production)
ENABLE_COLLABORATION=false

# Enable collaboration API endpoints (disabled by default in production)  
ENABLE_COLLABORATION_API=false

# Enable Socket.IO server (disabled by default in production)
ENABLE_SOCKET_IO=false

# Stripe Configuration
# Get these values from your Stripe dashboard
# Use test values for development, live values for production

STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE=19.99